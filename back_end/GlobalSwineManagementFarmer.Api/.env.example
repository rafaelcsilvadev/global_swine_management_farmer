# Database configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

ConnectionStrings__Default=Host=localhost;Port=5432;Database=your_db_name;Username=your_db_user;Password=your_db_password

# JWT configuration (use Jwt__Key format for .NET hierarchical binding)
Jwt__Secret=your_very_long_and_secure_jwt_secret_key_here
Jwt__Issuer=GlobalSwineManagement
Jwt__Audience=FarmerApp
Jwt__ExpirationMinutes=60
